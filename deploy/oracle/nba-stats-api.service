[Unit]
Description=NBA Stats API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/nba-stats-api
EnvironmentFile=/etc/nba-stats-api.env
ExecStart=/opt/nba-stats-api/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 90 --bind 127.0.0.1:5000 app:app
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
